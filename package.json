{
  "name": "meridian",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-border wealth intelligence platform — statement-based total-wealth ledger with US/UK intelligence. Personal clean-sheet project; synthetic/test data only in v0.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --import tsx --test test/schema.test.ts test/params.test.ts test/fixtures.test.ts",
    "lint": "eslint src test",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"schema/**/*.json\" \"params/**/*.json\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "eslint": "^9.9.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.0.0"
  }
}
