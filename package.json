{
  "name": "meridian",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-border wealth intelligence platform — statement-based total-wealth ledger with US/UK intelligence. Personal clean-sheet project; synthetic/test data only in v0.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "scan": "node scripts/precommit-scan.mjs",
    "gen:golden": "node --import tsx scripts/gen-golden-ingest.mts",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"schema/**/*.json\" \"params/**/*.json\"",
    "typecheck": "tsc --noEmit",
    "build:web": "node scripts/build-web.mjs",
    "serve:web": "npm run build:web && cd docs && python3 -m http.server 8799"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "esbuild": "^0.28.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "eslint": "^9.9.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.0.0"
  }
}
