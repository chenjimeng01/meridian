{
  "jurisdiction": "SHARED",
  "name": "redaction-vocabulary",
  "effective": { "from": "2026-01-01", "to": "2099-12-31" },
  "policy": {
    "unknown_proper_noun_detection": {
      "value": "flag_capitalised_runs_with_no_vocabulary_token",
      "source": "Meridian design decision implementing SPEC §5.2 'local regex + NER pass' deterministically: a run of two or more capitalised tokens containing no financial/institutional/geographic/temporal vocabulary token is treated as an unrecognised personal name and hard-fails before egress",
      "status": "published",
      "notes": "Deterministic substitute for a trained NER model in v0 (SPEC §2.1 forbids model output in the core). It fails loudly and forces the operator to extend the vault or this vocabulary; it does not silently redact. KNOWN LIMITATION: a bare single-token surname on its own is not detected unless preceded by an honorific — logged in PROGRESS.md for human review."
    },
    "min_run_length": {
      "value": 2,
      "source": "Meridian design decision: single capitalised tokens are pervasive in statement layouts (Cash, Balance, Holding, TOTAL) and flagging them would make the gate unusable",
      "status": "published"
    }
  },
  "safe_tokens": {
    "comment": "A capitalised run is SAFE if ANY of its tokens appears here. Case-insensitive. Extend rather than weaken the detector.",
    "corporate_and_legal": [
      "PLC", "LTD", "LIMITED", "LLP", "INC", "CORP", "CORPORATION", "COMPANY", "CO", "GROUP", "HOLDINGS", "NV", "SA", "AG", "SE", "TRUSTEES", "TRUSTEE", "NOMINEES", "PARTNERS", "PARTNERSHIP"
    ],
